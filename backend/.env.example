PORT=3000
FRONTEND_URL=http://localhost:5173

# OAuth Web application credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Google Calendar reuses the Gmail OAuth client by default. Override these only
# when using a separate Calendar OAuth client. Register the redirect URI below.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/auth/google/calendar/callback
FRONTEND_ORIGIN=http://localhost:5173

# Use the same Supabase project as the frontend. This is the publishable/anon key,
# used only to validate a user's access token; never put a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini API key and a model enabled for your Google AI project.
GEMINI_API_KEY=
GEMINI_MODEL=
